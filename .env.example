# Postgres (Neon). Preenchidas por `neon deploy` / `neon env pull`.
# DATABASE_URL: pooled (-pooler), usada pelo app.
# DATABASE_URL_UNPOOLED: direta, usada pelo drizzle-kit nas migrations.
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Auth.js — gere com: pnpm dlx auth secret  (ou: openssl rand -base64 33)
AUTH_SECRET=""

# Google OAuth (Google Cloud Console > APIs e serviços > Credenciais)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Único e-mail autorizado a entrar no portal
ALLOWED_EMAIL=""

# Só fora da Vercel (ex.: `pnpm start` local ou outro host): confia no header Host.
# AUTH_TRUST_HOST=true
